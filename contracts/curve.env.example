# curve.env.example — every figure a title's launch curve needs, in one place.
#
#   cp curve.env.example curve.env    # curve.env IS gitignored (`*.env`).
#                                     # Put the key in the environment, never here.
#   set -a; . ./curve.env; set +a
#   forge script script/DeployCurve.s.sol --rpc-url $RPC      # DRY RUN FIRST
#
# ⚠ THIS FILE DID NOT EXIST UNTIL 2026-08-18, AND `ScryCurve` IS THE CONTRACT
#   THAT MOST NEEDED IT. `elo.env.example` and `hive.env.example` both stage
#   their launch carefully; the curve — 15 variables, ALL of them welded — was
#   staged nowhere, so every figure was typed from a script header on the day.
#   Three of them silently default (see [WELDED-DEFAULT] below), which is the
#   one shape those other two files exist to prevent.
#
# ⚠ PRIVATE_KEY IS NOT IN THIS FILE AND MUST NOT BE ADDED TO IT.
#
# LEGEND:
#
#   [WELDED]          fixed at construction. `ScryCurve` has NO owner, NO
#                     steward and NO setter of any kind. There is nothing to fix
#                     afterwards — a wrong number is a redeploy, and a redeploy
#                     after anyone has bought is a second market in the same coin.
#   [WELDED-DEFAULT]  welded AND it defaults if you leave it blank. The most
#                     dangerous class in this tree: it lands on a value nobody
#                     chose and is indistinguishable afterwards from one somebody did.
#   [LOCAL]           a pre-broadcast guard. Changes nothing on chain.
#
# Anything marked <UNSPOKEN> has no operator sentence in docs/SENTENCES.md and
# is left BLANK on purpose.

# ── the chain ────────────────────────────────────────────────────────────────
RPC=https://rpc.mainnet.chain.robinhood.com
# PRIVATE_KEY — export it in your shell. Not here.

# ── the pair ─────────────────────────────────────────────────────────────────
# [WELDED] The game's coin. Funded by transfer after the deploy, never minted by
# the curve — step 2 of the order in DeployCurve.s.sol's header.
CURVE_COIN=

# ⚠ [WELDED] THE QUOTE ASSET IS **ELO**, AND THE SCRIPT HEADER SAID SCRY UNTIL
#   2026-08-18. GATES.md 2.1: a game coin prices against THE RESERVE and only
#   there. SCRY is the retired reserve (ONE-SHOT.md 2) — quoting a new game coin
#   against it welds the new economy to the coin being left behind, and there is
#   no setter to undo it. Read the address out of
#   contracts/deployments.json -> chains.4663.contracts.ELO, which does not
#   exist until the pons launch is recorded.
CURVE_QUOTE=

# [WELDED] The canonical v3 NonfungiblePositionManager the graduated pool mints
# through. contracts/deployments.json / watchtower/pools.config.json `npm`.
CURVE_NPM=

# ── the four fee destinations, and they are welded per contract ──────────────
# ⚠ <UNSPOKEN — ONE-SHOT.md 8 item 10> ALL FOUR. That item says to decide every
#   welded fee destination in the tree AS ONE TABLE rather than one deploy at a
#   time, precisely so these four do not get answered in a hurry on curve day.
#   None has a sentence. The script takes no default for them.
#
#   ⚠ And note which of these are OURS versus the LISTER'S. On a third-party
#   listing the creator leg is theirs and the protocol leg is ours; on Gates we
#   are both, which is exactly the case where a placeholder survives review
#   because it looks right.
CURVE_CREATOR_FEES=          # the studio's cut of trading fees
CURVE_PROTOCOL_FEES=         # ours
CURVE_QUOTE_POOL_FEES=       # the ELO leg's fees, once graduated
CURVE_COIN_POOL_FEES=        # the coin leg — the game's own splitter

# ── the shape of the curve ───────────────────────────────────────────────────
# ⚠ [WELDED] THESE FOUR ARE THE PRICE. `CURVE_VIRTUAL_QUOTE` sets the OPENING
#   price off a reserve that contains nothing — that is what lets the curve
#   quote a price with no ELO in it and take sell-backs from the first trade.
CURVE_VIRTUAL_QUOTE=         # sets the opening price
CURVE_ALLOC=                 # coin the curve may sell
CURVE_POOL_ALLOC=            # coin held back; becomes the pool's coin side
CURVE_THRESHOLD=             # ELO raised at which the curve closes

# ⚠ THE GAP BETWEEN TWO PRICES IS THE NUMBER TO ARGUE ABOUT, and it is arithmetic
#   ACROSS the four figures above rather than any one of them:
#
#     the curve CLOSES at a marginal price set by the virtual reserve, the
#     allocation and the threshold;
#     the pool OPENS at threshold / poolAlloc.
#
#   Size them to agree. If the pool opens far below the curve's close, the last
#   buyer on the curve is underwater the moment trading moves.
#
#   ⚠ ONE-SHOT.md 5 called this "checked by nothing" and that is NOT true —
#   DeployCurve computes both prices from the constructor's own figures and
#   REFUSES over CURVE_MAX_GAP_BPS. What is true is that the check is worthless
#   after the broadcast, because nothing here has a setter. Read the preview the
#   script prints BEFORE you broadcast.

# ── the three that weld themselves if you say nothing ────────────────────────
# ⚠ [WELDED-DEFAULT] Each of these is `vm.envOr` over an immutable. Leaving one
#   blank does not leave it open — it welds the number in the comment. Type them.
CURVE_POOL_FEE=10000         # the ELO/coin tier. 10000 = 1%
CURVE_FEE_BPS=100            # trading fee on the curve. 100 = 1%
CURVE_PROTOCOL_SHARE=1000    # our share OF that fee. 1000 = 10%

# ── the guard ────────────────────────────────────────────────────────────────
# [LOCAL] Refuse the deploy if the closing and opening prices differ by more
# than this. 500 = 5%. Tighten it rather than loosening it: this is the only
# thing standing between a typo in the four figures above and a launch whose
# last curve buyer is instantly underwater.
CURVE_MAX_GAP_BPS=500

# ── before you broadcast ─────────────────────────────────────────────────────
# ⚠ NOT FORK-TESTED. ScryCurve's suite runs against MOCK v3. It pins the
#   contract's own arithmetic and its exits; it proves nothing about tick math,
#   the ratio a real mint consumes, or what `collect` returns. Fork against the
#   canonical addresses before this holds a wei.
#
# ⚠ AND REHEARSE IT AGAINST A THROWAWAY QUOTE TODAY. ONE-SHOT.md 7 step 0c: the
#   curve cannot be rehearsed against ELO before ELO exists, and can be
#   rehearsed against any address at all right now.

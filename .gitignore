# Build output. The publish script mirrors TRACKED files only, so nothing here
# is ever published from upstream — this exists so that building or testing
# inside a clone of THIS repo does not dirty it. (No `contracts/` entries: the
# Solidity is not mirrored here — see MIRROR above.)
/launcher-rs/target/
__pycache__/
*.pyc
# The SDK packages' own build output (sdk/README.md): cargo, pip, npm.
/sdk/rust/target/
/sdk/python/build/
/sdk/python/dist/
*.egg-info/
/sdk/js/node_modules/
/sdk/js/*.tgz
# The Python client's build output.
/clients/python/build/
/clients/python/dist/

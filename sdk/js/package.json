{
  "name": "@elopros/sdk",
  "version": "0.2.0",
  "description": "The Elo Pros platform SDK: friends and buddies, tickets, items, faces, leaderboards and payout files over the platform API, a game server's sign-in check and roster sweep, the signed texts rebuilt locally, and the browser web SDK (elo-3.js; elo-1.js and elo-2.js kept).",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./elo-1.js": "./elo-1.js",
    "./elo-2.js": "./elo-2.js",
    "./elo-3.js": {
      "types": "./elo-3.d.ts",
      "default": "./elo-3.js"
    },
    "./elo-3": {
      "types": "./elo-3.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "elo-1.js",
    "elo-2.js",
    "elo-3.js",
    "elo-3.d.ts",
    "examples/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "gamedev",
    "ethereum",
    "sdk",
    "multiplayer",
    "elopros"
  ],
  "homepage": "https://elopros.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnthonE/elo-pros-launcher.git",
    "directory": "sdk/js"
  },
  "license": "MIT",
  "sideEffects": [
    "./elo-1.js",
    "./elo-2.js",
    "./elo-3.js"
  ]
}

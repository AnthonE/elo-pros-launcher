{
  "about": "The cases every order implementation must pass: watchtower/js/orders-core.js (run by watchtower/test_site.py under node) and launcher-rs/crates/elo-launcher/src/orders.rs (cargo test). Each case feeds its ticks in order, carrying the order's state; each tick names the action expected and, when it fires, the amount.",
  "cases": [
    {"name": "a limit buy waits, then fires once at or under its price",
     "order": {"kind": "limit", "coin": "JUNK", "price": 2.0, "amount": "0.01"},
     "ticks": [{"price": 2.5, "now": 0, "action": "none"}, {"price": 2.0, "now": 10, "action": "fire", "amount": "0.01"},
               {"price": 1.0, "now": 20, "action": "done"}]},
    {"name": "a take-profit fires at or over",
     "order": {"kind": "take-profit", "coin": "JUNK", "price": 2.0, "amount": "500"},
     "ticks": [{"price": 1.5, "now": 0, "action": "none"}, {"price": 2.1, "now": 1, "action": "fire", "amount": "500"}]},
    {"name": "a stop fires at or under",
     "order": {"kind": "stop", "coin": "JUNK", "price": 1.0, "amount": "500"},
     "ticks": [{"price": 1.2, "now": 0, "action": "none"}, {"price": 1.0, "now": 1, "action": "fire", "amount": "500"}]},
    {"name": "a trailing stop follows the high and fires 10% under it",
     "order": {"kind": "trailing-stop", "coin": "JUNK", "pct": 10, "amount": "500"},
     "ticks": [{"price": 1.0, "now": 0, "action": "none"}, {"price": 2.0, "now": 1, "action": "none"},
               {"price": 1.85, "now": 2, "action": "none"}, {"price": 1.8, "now": 3, "action": "fire", "amount": "500"}]},
    {"name": "a trailing buy follows the low and fires 10% over it",
     "order": {"kind": "trailing-buy", "coin": "JUNK", "pct": 10, "amount": "0.01"},
     "ticks": [{"price": 2.0, "now": 0, "action": "none"}, {"price": 1.0, "now": 1, "action": "none"},
               {"price": 1.05, "now": 2, "action": "none"}, {"price": 1.1, "now": 3, "action": "fire", "amount": "0.01"}]},
    {"name": "a bracket takes whichever side comes first",
     "order": {"kind": "bracket", "coin": "JUNK", "tp": 3.0, "stop": 1.0, "amount": "500"},
     "ticks": [{"price": 2.0, "now": 0, "action": "none"}, {"price": 0.9, "now": 1, "action": "fire", "amount": "500"},
               {"price": 3.5, "now": 2, "action": "done"}]},
    {"name": "a DCA buys on its slots and ends after its count",
     "order": {"kind": "dca", "coin": "JUNK", "side": "buy", "amount": "0.01", "every_s": 100, "times": 3},
     "ticks": [{"price": 1.0, "now": 0, "action": "fire", "amount": "0.01"}, {"price": 1.0, "now": 50, "action": "none"},
               {"price": 1.0, "now": 100, "action": "fire", "amount": "0.01"}, {"price": 1.0, "now": 200, "action": "fire", "amount": "0.01"},
               {"price": 1.0, "now": 300, "action": "done"}]},
    {"name": "a DCA with a cap skips a slot over it, and the skip still counts",
     "order": {"kind": "dca", "coin": "JUNK", "side": "buy", "amount": "0.01", "every_s": 100, "times": 2, "cap": 1.5},
     "ticks": [{"price": 2.0, "now": 0, "action": "none"}, {"price": 1.0, "now": 100, "action": "fire", "amount": "0.01"},
               {"price": 1.0, "now": 200, "action": "done"}]},
    {"name": "a TWAP splits its amount over its duration",
     "order": {"kind": "twap", "coin": "JUNK", "side": "sell", "amount": "1000", "over_s": 400, "parts": 4},
     "ticks": [{"price": 1.0, "now": 0, "action": "fire", "amount": "250"}, {"price": 1.0, "now": 99, "action": "none"},
               {"price": 1.0, "now": 100, "action": "fire", "amount": "250"}, {"price": 1.0, "now": 200, "action": "fire", "amount": "250"},
               {"price": 1.0, "now": 300, "action": "fire", "amount": "250"}, {"price": 1.0, "now": 400, "action": "done"}]},
    {"name": "no price, no decision",
     "order": {"kind": "stop", "coin": "JUNK", "price": 1.0, "amount": "500"},
     "ticks": [{"price": 0, "now": 0, "action": "none"}]}
  ],
  "invalid": [
    {"kind": "market", "coin": "JUNK", "amount": "1"},
    {"kind": "limit", "coin": "ETH", "price": 1, "amount": "1"},
    {"kind": "limit", "coin": "JUNK", "price": 0, "amount": "1"},
    {"kind": "trailing-stop", "coin": "JUNK", "pct": 120, "amount": "1"},
    {"kind": "bracket", "coin": "JUNK", "tp": 1, "stop": 2, "amount": "1"},
    {"kind": "dca", "coin": "JUNK", "side": "buy", "amount": "1", "every_s": 0, "times": 3},
    {"kind": "twap", "coin": "JUNK", "side": "hold", "amount": "1", "over_s": 60, "parts": 2}
  ],
  "price_eth": {
    "pairs": [{"base": "ELO", "quote": "ETH", "price": 1e-8, "chain": "rh"},
              {"base": "JUNK", "quote": "ELO", "price": 0.5, "chain": "rh"},
              {"base": "XYZ", "quote": "SOL", "price": 3, "chain": "solana"}],
    "expect": {"ELO": 1e-8, "JUNK": 5e-9, "XYZ": null}
  }
}
